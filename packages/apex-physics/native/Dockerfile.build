FROM emscripten/emsdk:6.0.2

# Closure Compiler incluido con Emscripten 6 requiere Java 21. La imagen base
# todavía trae Java 11, suficiente para emcc pero no para el enlace optimizado.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
